1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"headline\":\"Progress of the Jinping Underground Nuclear Astrophysics (JUNA) Experimental Platform\",\"description\":\"A review of the underground environment, intense-beam accelerator, detectors, targets and published nuclear astrophysics research.\",\"inLanguage\":\"en\",\"identifier\":\"10.1146/annurev-nucl-121423-101021\",\"sameAs\":\"https://doi.org/10.1146/annurev-nucl-121423-101021\",\"url\":\"https://arcxya09.github.io/juna/publications/juna-platform-review-2025/\",\"datePublished\":\"2025-06-26\",\"isPartOf\":{\"@type\":\"PublicationIssue\",\"isPartOf\":{\"@type\":\"Periodical\",\"name\":\"Annual Review of Nuclear and Particle Science\"}}}"}}],["$","$Ld",null,{"paper":{"slug":"juna-platform-review-2025","reactionId":"review","kind":"review","language":"en","authors":"Weiping Liu, Bing Guo, Jianjun He, Zhihong Li, Xiaodong Tang, Maria Lugaro and Gang Lian","volume":"75","pages":"271–299","publishedOnline":"2025-06-26","doi":"10.1146/annurev-nucl-121423-101021","url":"https://doi.org/10.1146/annurev-nucl-121423-101021","journal":"Annual Review of Nuclear and Particle Science","year":"2025","englishTitle":"Progress of the Jinping Underground Nuclear Astrophysics (JUNA) Experimental Platform","title":["JUNA 实验平台的发展与研究进展","Development and progress of the JUNA experimental platform"],"summary":["综述深地低本底环境、强流加速器、探测器与靶技术，以及已公开的核天体物理研究。","A review of the underground environment, intense-beam accelerator, detectors, targets and published nuclear astrophysics research."],"detail":["这篇综述梳理 JUNA 实验平台的建设、测量方法与公开成果，讨论接近或进入伽莫夫窗口的直接测量及后续研究方向。适合从装置能力和科学任务两方面了解 JUNA。在线发表于 2025 年 6 月 26 日，刊于 Annual Review of Nuclear and Particle Science 75, 271–299（2025），开放获取。","This review describes the development of JUNA, its measurement methods and published results, including direct measurements within or near Gamow windows and future research directions. It connects the platform’s technical capabilities to its scientific programme. Published online on 26 June 2025 in Annual Review of Nuclear and Particle Science 75, 271–299 (2025), with open access."],"citation":"Weiping Liu et al. Progress of the Jinping Underground Nuclear Astrophysics (JUNA) Experimental Platform. Annual Review of Nuclear and Particle Science 75, 271–299 (2025). https://doi.org/10.1146/annurev-nucl-121423-101021","bibtex":"@article{Liu2025JUNAPlatform,\n  author = {Liu, Weiping and Guo, Bing and He, Jianjun and Li, Zhihong and Tang, Xiaodong and Lugaro, Maria and Lian, Gang},\n  title = {Progress of the Jinping Underground Nuclear Astrophysics ({JUNA}) Experimental Platform},\n  journal = {Annual Review of Nuclear and Particle Science},\n  year = {2025},\n  volume = {75},\n  pages = {271--299},\n  doi = {10.1146/annurev-nucl-121423-101021},\n  url = {https://doi.org/10.1146/annurev-nucl-121423-101021}\n}"}}]]
