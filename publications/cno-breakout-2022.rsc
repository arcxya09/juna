1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"headline\":\"Measurement of ¹⁹F(p, γ)²⁰Ne reaction suggests CNO breakout in first stars\",\"description\":\"A measurement of ¹⁹F(p,γ)²⁰Ne constrains a pathway for calcium production in the first stars.\",\"inLanguage\":\"en\",\"identifier\":\"10.1038/s41586-022-05230-x\",\"sameAs\":\"https://doi.org/10.1038/s41586-022-05230-x\",\"url\":\"https://arcxya09.github.io/juna/publications/cno-breakout-2022/\",\"datePublished\":\"2022-10-26\",\"isPartOf\":{\"@type\":\"PublicationIssue\",\"isPartOf\":{\"@type\":\"Periodical\",\"name\":\"Nature\"}}}"}}],["$","$Le",null,{"paper":{"slug":"cno-breakout-2022","reactionId":"fluorine","authors":"Liyong Zhang et al.","volume":"610","pages":"656–660","publishedOnline":"2022-10-26","kind":"research","language":"en","citation":"Liyong Zhang et al. Measurement of ¹⁹F(p, γ)²⁰Ne reaction suggests CNO breakout in first stars. Nature 610, 656–660 (2022). https://doi.org/10.1038/s41586-022-05230-x","bibtex":"@article{Zhang2022CNOBreakout,\n  author = {Zhang, Liyong and others},\n  title = {Measurement of {$^{19}$F(p, $\\gamma$)$^{20}$Ne} reaction suggests {CNO} breakout in first stars},\n  journal = {Nature},\n  year = {2022},\n  volume = {610},\n  pages = {656--660},\n  doi = {10.1038/s41586-022-05230-x},\n  url = {https://doi.org/10.1038/s41586-022-05230-x},\n}","doi":"10.1038/s41586-022-05230-x","url":"https://doi.org/10.1038/s41586-022-05230-x","journal":"Nature","year":"2022","title":["第一代恒星中的 CNO 循环突破反应","CNO breakout in the first stars"],"englishTitle":"Measurement of ¹⁹F(p, γ)²⁰Ne reaction suggests CNO breakout in first stars","summary":["测量 ¹⁹F(p,γ)²⁰Ne 反应，为第一代恒星中钙的形成途径提供实验依据。","A measurement of ¹⁹F(p,γ)²⁰Ne constrains a pathway for calcium production in the first stars."],"detail":["JUNA 对 ¹⁹F(p,γ)²⁰Ne 的低能测量，为物质从碳氮氧循环向更重元素的转化提供了实验约束。研究结合恒星模型，讨论了第一代恒星中钙的形成路径。这项工作是氟反应研究的扩展，区别于首批核心反应中的 ¹⁹F(p,α)¹⁶O。发表于 Nature 610, 656–660。","JUNA’s low-energy measurement of ¹⁹F(p,γ)²⁰Ne constrains a route from the carbon–nitrogen–oxygen cycles to heavier elements. Combined with stellar models, it suggests a pathway for calcium production in the first stars. This extends the fluorine programme beyond the initial ¹⁹F(p,α)¹⁶O reaction. Published in Nature 610, 656–660."]}}]]
