1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"headline\":\"First result from the Jinping Underground Nuclear Astrophysics experiment JUNA: precise measurement of the 92 keV ²⁵Mg(p, γ)²⁶Al resonance\",\"description\":\"Nuclear data for stellar aluminium-26 production and Galactic gamma-ray observations.\",\"inLanguage\":\"en\",\"identifier\":\"10.1016/j.scib.2021.10.018\",\"sameAs\":\"https://doi.org/10.1016/j.scib.2021.10.018\",\"url\":\"https://arcxya09.github.io/juna/publications/magnesium-resonance-2022/\",\"datePublished\":\"2021-10-28\",\"isPartOf\":{\"@type\":\"PublicationIssue\",\"isPartOf\":{\"@type\":\"Periodical\",\"name\":\"Science Bulletin\"}}}"}}],["$","$Ld",null,{"paper":{"slug":"magnesium-resonance-2022","reactionId":"magnesium","authors":"Jun Su et al. (JUNA Collaboration)","volume":"67","pages":"125–132","publishedOnline":"2021-10-28","kind":"research","language":"en","citation":"Jun Su et al. (JUNA Collaboration). First result from the Jinping Underground Nuclear Astrophysics experiment JUNA: precise measurement of the 92 keV ²⁵Mg(p, γ)²⁶Al resonance. Science Bulletin 67, 125–132 (2022). https://doi.org/10.1016/j.scib.2021.10.018","bibtex":"@article{Su2022MagnesiumResonance,\n  author = {Su, Jun and others},\n  title = {First result from the Jinping Underground Nuclear Astrophysics experiment {JUNA}: precise measurement of the 92 keV {$^{25}$Mg(p, $\\gamma$)$^{26}$Al} resonance},\n  journal = {Science Bulletin},\n  year = {2022},\n  volume = {67},\n  pages = {125--132},\n  doi = {10.1016/j.scib.2021.10.018},\n  url = {https://doi.org/10.1016/j.scib.2021.10.018},\n}","doi":"10.1016/j.scib.2021.10.018","url":"https://doi.org/10.1016/j.scib.2021.10.018","journal":"Science Bulletin","year":"2022","title":["精确测量 ²⁵Mg(p,γ)²⁶Al 的 92 keV 共振","A precise measurement of the 92 keV ²⁵Mg(p,γ)²⁶Al resonance"],"englishTitle":"First result from the Jinping Underground Nuclear Astrophysics experiment JUNA: precise measurement of the 92 keV ²⁵Mg(p, γ)²⁶Al resonance","summary":["为恒星中的铝-26 合成及银河系 γ 射线观测提供关键核数据。","Nuclear data for stellar aluminium-26 production and Galactic gamma-ray observations."],"detail":["铝-26 基态的放射性衰变产生 1.809 MeV 特征 γ 射线，是研究银河系近期元素合成的重要线索。JUNA 首批成果精确测量了 ²⁵Mg(p,γ)²⁶Al 反应的 92 keV 共振，为恒星反应率提供关键输入。论文于 2021 年在线发表，刊于 Science Bulletin 67, 125–132（2022）。","The decay of ground-state aluminium-26 produces a characteristic 1.809 MeV gamma ray, a tracer of recent Galactic nucleosynthesis. An early JUNA result precisely measured the 92 keV resonance in ²⁵Mg(p,γ)²⁶Al, supplying a key input to stellar reaction rates. Published online in 2021 and in Science Bulletin 67, 125–132 (2022)."]}}]]
