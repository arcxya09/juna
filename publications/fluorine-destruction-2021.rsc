1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"headline\":\"Direct Measurement of the Astrophysical ¹⁹F(p,αγ)¹⁶O Reaction in the Deepest Operational Underground Laboratory\",\"description\":\"Measurements at energies relevant to AGB stars reduce uncertainty in fluorine-destruction rates.\",\"inLanguage\":\"en\",\"identifier\":\"10.1103/PhysRevLett.127.152702\",\"sameAs\":\"https://doi.org/10.1103/PhysRevLett.127.152702\",\"url\":\"https://arcxya09.github.io/juna/publications/fluorine-destruction-2021/\",\"datePublished\":\"2021-10-07\",\"isPartOf\":{\"@type\":\"PublicationIssue\",\"isPartOf\":{\"@type\":\"Periodical\",\"name\":\"Physical Review Letters\"}}}"}}],["$","$Le",null,{"paper":{"slug":"fluorine-destruction-2021","reactionId":"fluorine","authors":"L. Y. Zhang et al.","volume":"127","pages":"152702","publishedOnline":"2021-10-07","kind":"research","language":"en","citation":"L. Y. Zhang et al. Direct Measurement of the Astrophysical ¹⁹F(p,αγ)¹⁶O Reaction in the Deepest Operational Underground Laboratory. Physical Review Letters 127, 152702 (2021). https://doi.org/10.1103/PhysRevLett.127.152702","bibtex":"@article{Zhang2021FluorineDestruction,\n  author = {Zhang, L. Y. and others},\n  title = {Direct Measurement of the Astrophysical {$^{19}$F(p,$\\alpha\\gamma$)$^{16}$O} Reaction in the Deepest Operational Underground Laboratory},\n  journal = {Physical Review Letters},\n  year = {2021},\n  volume = {127},\n  pages = {152702},\n  doi = {10.1103/PhysRevLett.127.152702},\n  url = {https://doi.org/10.1103/PhysRevLett.127.152702},\n}","doi":"10.1103/PhysRevLett.127.152702","url":"https://doi.org/10.1103/PhysRevLett.127.152702","journal":"Physical Review Letters","year":"2021","title":["低能区直接测量氟的质子反应","Direct measurement of low-energy proton-induced fluorine reactions"],"englishTitle":"Direct Measurement of the Astrophysical ¹⁹F(p,αγ)¹⁶O Reaction in the Deepest Operational Underground Laboratory","summary":["推进渐近巨星支恒星相关能区的测量，降低氟消耗反应率的不确定度。","Measurements at energies relevant to AGB stars reduce uncertainty in fluorine-destruction rates."],"detail":["¹⁹F(p,α)¹⁶O 是恒星中氟的重要消耗通道。实验利用深地低本底环境直接测量伴随 γ 射线发射的反应分支，推动相关低能区研究，并降低恒星模型中氟反应率的不确定度。发表于 Physical Review Letters 127, 152702。","The ¹⁹F(p,α)¹⁶O reaction is an important pathway for fluorine destruction in stars. Using the underground low-background environment, the experiment directly measured gamma-emitting branches at low energies and reduced reaction-rate uncertainties in stellar models. Published in Physical Review Letters 127, 152702."]}}]]
