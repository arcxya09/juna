1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"headline\":\"Deep Underground Laboratory Measurement of ¹³C(α,n)¹⁶O in the Gamow Windows of the s and i Processes\",\"description\":\"Underground and surface measurements constrain a key neutron source for the s and i processes.\",\"inLanguage\":\"en\",\"identifier\":\"10.1103/PhysRevLett.129.132701\",\"sameAs\":\"https://doi.org/10.1103/PhysRevLett.129.132701\",\"url\":\"https://arcxya09.github.io/juna/publications/carbon-neutron-source-2022/\",\"datePublished\":\"2022-09-23\",\"isPartOf\":{\"@type\":\"PublicationIssue\",\"isPartOf\":{\"@type\":\"Periodical\",\"name\":\"Physical Review Letters\"}}}"}}],["$","$Ld",null,{"paper":{"slug":"carbon-neutron-source-2022","reactionId":"neutron","authors":"B. Gao et al. (JUNA Collaboration)","volume":"129","pages":"132701","publishedOnline":"2022-09-23","kind":"research","language":"en","citation":"B. Gao et al. (JUNA Collaboration). Deep Underground Laboratory Measurement of ¹³C(α,n)¹⁶O in the Gamow Windows of the s and i Processes. Physical Review Letters 129, 132701 (2022). https://doi.org/10.1103/PhysRevLett.129.132701","bibtex":"@article{Gao2022NeutronSource,\n  author = {Gao, B. and others},\n  title = {Deep Underground Laboratory Measurement of {$^{13}$C($\\alpha$,n)$^{16}$O} in the Gamow Windows of the s and i Processes},\n  journal = {Physical Review Letters},\n  year = {2022},\n  volume = {129},\n  pages = {132701},\n  doi = {10.1103/PhysRevLett.129.132701},\n  url = {https://doi.org/10.1103/PhysRevLett.129.132701},\n}","doi":"10.1103/PhysRevLett.129.132701","url":"https://doi.org/10.1103/PhysRevLett.129.132701","journal":"Physical Review Letters","year":"2022","title":["深地测量恒星中子源 ¹³C(α,n)¹⁶O","Measuring the stellar neutron source ¹³C(α,n)¹⁶O"],"englishTitle":"Deep Underground Laboratory Measurement of ¹³C(α,n)¹⁶O in the Gamow Windows of the s and i Processes","summary":["结合地下与地面实验，约束慢中子俘获与中间中子俘获过程的关键中子源。","Underground and surface measurements constrain a key neutron source for the s and i processes."],"detail":["¹³C(α,n)¹⁶O 是恒星重元素合成的重要中子源。研究结合深地与地面测量，获得自洽的反应数据，几乎完整覆盖中间中子俘获过程（i 过程）的伽莫夫窗口，为反应率评估提供新的实验约束。发表于 Physical Review Letters 129, 132701。","The ¹³C(α,n)¹⁶O reaction supplies neutrons for stellar heavy-element production. The study combines underground and surface measurements into a self-consistent dataset, almost completely covering the i-process Gamow window and providing new experimental constraints on the reaction rate. Published in Physical Review Letters 129, 132701."]}}]]
